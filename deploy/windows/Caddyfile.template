# Caddy for Kassa: HTTPS in front of the application. install-services.ps1 fills in the
# address and the log folder and writes the result to C:\kassa\config\Caddyfile. To change
# something later, edit that file and restart the service "KassaProxy".
{
	# The management endpoint of Caddy is not needed here, and anything on this machine could
	# reconfigure the proxy through it.
	admin off
}

__SITE__ {
	encode zstd gzip

	# Caddy puts the real address of the client into X-Forwarded-For (and throws away one sent
	# by the client). The server believes it because TRUST_PROXY=127.0.0.1 is in its settings.
	reverse_proxy 127.0.0.1:3000

	log {
		output file __LOGS__/caddy-access.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
