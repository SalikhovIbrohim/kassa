{
  "name": "kassa",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w server",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server"
  }
}
