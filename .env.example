# Settings of the Kassa server. It reads them as environment variables; for a local run copy this file to .env
# (never commit .env). Every variable the code reads is listed here, with what it is for.
#
# One file is one installation: one company, with its own database, its own Telegram bot and group, its own 1C base.
# Nothing about a company is in the code: a second company is a second file, a second database and a second
# process. A server (Windows 10) keeps its file outside the repository; deploy/setup-database.mjs writes it from
# deploy/kassa.env.example (see docs/deploy-windows.md).

# --- The server ---

# Required. The database of this installation: postgres://user:password@host:port/database. The migrations are
# applied to it when the server starts.
DATABASE_URL=postgres://kassa:kassa@localhost:5432/kassa
# The port the server listens on (default 3000). Every installation on one machine has a port of its own.
PORT=3000
# The address it listens on. Loopback by default; 0.0.0.0 inside a container or when the proxy is on another machine.
HOST=127.0.0.1
# production on a server: the session cookie then goes over HTTPS only (see COOKIE_SECURE).
# NODE_ENV=production
# Session cookie only over HTTPS. Defaults to true when NODE_ENV=production, else false.
# COOKIE_SECURE=true
# Days a session lives without use (default 90). Active users are extended automatically.
# SESSION_DAYS=90
# Reverse proxies whose X-Forwarded-For header is believed, comma separated. Set this to the address the proxy
# connects from (Caddy on the same machine: 127.0.0.1) so that the limit on wrong passwords is counted per real
# client. Leave unset without a proxy: the header is then ignored, because anyone could forge it.
# TRUST_PROXY=127.0.0.1
# The folder with the built web app. Defaults to web/dist.
# WEB_DIST_DIR=web/dist
# An emergency switch: 1 lets the server start on a database that a newer version has changed. Balances may be wrong.
# ALLOW_NEWER_SCHEMA=1
# The name of this installation when it is not the only one on its machine: one short lower-case word (express).
# The scripts of deploy/windows name its service and its tasks by it (setup.ps1 -Instance writes it); the server
# itself only uses it to name that service in a hint. Unset for the first installation.
# INSTANCE=

# --- Telegram: the Mini App and the messages to the group of the company ---

# The token of the company's own bot (from @BotFather). Unset: signing in inside Telegram is off, and no messages.
# TELEGRAM_BOT_TOKEN=
# The group that is told of the entries: its number, which starts with a minus (admin command telegram-chats finds
# it). Needs the token. Unset: no messages are sent or queued.
# TELEGRAM_GROUP_CHAT_ID=-1001234567890
# The topics of that group, if it has topics: one for the incomes, one for the expenses. A kind without a topic
# goes to the main topic.
# TELEGRAM_THREAD_INCOME=3
# TELEGRAM_THREAD_EXPENSE=5
# The topic for everything of the Andijan cash desk (incomes, expenses, corrections, counts). Unset: the main topic.
# TELEGRAM_THREAD_ANDIJAN=7
# The address of the Bot API. Only a test or a proxy to Telegram sets it (default https://api.telegram.org).
# TELEGRAM_API_URL=https://api.telegram.org

# --- 1C: the payments of clients written into the 1C base of the company as cash receipts ---
# (Before these were named ONEC_* they were COSMO_1C_MODE, COSMO_ODATA_URL, COSMO_ODATA_USER, COSMO_ODATA_PASSWORD,
# COSMO_1C_ORGANIZATION_KEY, COSMO_1C_KASSA_KEY, COSMO_1C_CURRENCY_KEY, COSMO_1C_CLIENTS and COSMO_1C_SEND. A settings
# file that has those names goes on working; a setting under its ONEC_ name wins.)

# off (the default: nothing is written or read), preview (reads 1C and says what would be written) or live (writes).
# ONEC_MODE=off
# The address of the OData service of the base, with or without the trailing /odata/standard.odata.
# ONEC_ODATA_URL=
# The login and the password of the 1C user the receipts are written as.
# ONEC_ODATA_USER=
# ONEC_ODATA_PASSWORD=
# The organization, the cash desk and the currency of the receipts, by their keys (GUIDs) in the base. The admin
# command onec-check says what each key names there.
# ONEC_ORGANIZATION_KEY=
# ONEC_KASSA_KEY=
# ONEC_CURRENCY_KEY=
# Only the payments of these clients are written (codes like А339, comma separated): for the first live receipt.
# Unset: the payments of all clients.
# ONEC_CLIENTS=
# When a payment goes to 1C: night (the default: at 03:00 Moscow time, when the day of the cash desk is over and
# the day's corrections are in) or now (right after the entry).
# ONEC_SEND=night

# --- The journal copied to a Google spreadsheet ---

# The id from the address of the spreadsheet (between /d/ and /edit). Set together with the key file. Unset: no copy.
# GOOGLE_SHEET_ID=
# The JSON key of the Google service account the spreadsheet is shared with as an editor: a path to the file.
# GOOGLE_SHEETS_KEY_FILE=C:\kassa\config\google-key.json
# The first day to copy (a day of the cash desk, YYYY-MM-DD). Unset: every entry.
# GOOGLE_SHEET_FROM=2026-10-14
# The sheet (tab) the journal goes to; made if it is not there (default Журнал).
# GOOGLE_SHEET_TAB=Журнал
# The address of the Sheets API. Only a test sets it (default https://sheets.googleapis.com).
# GOOGLE_SHEETS_API_URL=https://sheets.googleapis.com

# --- Copies of the database (deploy/backup.mjs, deploy/windows/backup.ps1): read from the settings file of a server ---

# Where the copies go: a full path, better on another disk. Without it backup.ps1 uses the folder backups under the
# root of the installation. Write the value without quotes (in single quotes if the path has a # in it).
# BACKUP_DIR=D:\kassa-copies
# How many nightly copies to keep (default 14); older ones are deleted after each new copy.
# BACKUP_KEEP=14
# The folder with pg_dump and pg_restore, if they are not found by themselves.
# PG_BIN=C:\Program Files\PostgreSQL\16\bin

# --- Read from the window a command is typed in, never from a settings file ---

# KASSA_PASSWORD         the password for the admin commands create-user and reset-password, instead of typing it
# KASSA_CHECK_PASSWORD   the password deploy/check.mjs --login signs in with
# PGPASSWORD             the password of the PostgreSQL administrator, for deploy/setup-database.mjs and
#                        deploy/restore.mjs (with PGUSER, default postgres; PGHOST, default 127.0.0.1; PGPORT, default 5432)

# --- Tests ---

# Tests create a throwaway database per test file on this server. The role needs CREATEDB (the tests of the
# deploy scripts also make roles: a superuser, as in CI).
TEST_DATABASE_URL=postgres://kassa_test:kassa_test@localhost:5432/postgres
# The browser of the tests in a real browser (npm run test:e2e), if Playwright's own is not installed.
# CHROMIUM_PATH=/usr/bin/chromium
