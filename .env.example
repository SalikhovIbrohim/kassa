# Server settings. Copy to .env for local runs (never commit .env).
DATABASE_URL=postgres://kassa:kassa@localhost:5432/kassa
PORT=3000
# Loopback by default. Use 0.0.0.0 inside a container or when the proxy is on another machine.
HOST=127.0.0.1
# Session cookie only over HTTPS. Defaults to true when NODE_ENV=production, else false.
# COOKIE_SECURE=true
# Days a session lives without use (default 90). Active users are extended automatically.
# SESSION_DAYS=90

# Optional: folder with the built web app. Defaults to web/dist.
# WEB_DIST_DIR=web/dist

# Tests create a throwaway database per test file on this server.
# The role needs CREATEDB.
TEST_DATABASE_URL=postgres://kassa_test:kassa_test@localhost:5432/postgres
